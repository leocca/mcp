# Configuration Serveur
DEBUG=True
LOG_LEVEL=INFO

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=devops-realm
KEYCLOAK_CLIENT_ID=mcp-server
KEYCLOAK_CLIENT_SECRET=<your_keycloak_client_secret>

# Dashboard de monitoring
FLASK_APP=dashboard/app.py
FLASK_SECRET_KEY=<generate_random_32chars>
DASHBOARD_PORT=5000
DASHBOARD_CLIENT_ID=dashboard
DASHBOARD_CLIENT_SECRET=<your_dashboard_keycloak_secret>
DASHBOARD_REDIRECT_URI=http://localhost:5000/callback

# Sécurité
JWT_SECRET=<generate_random_32chars>

# GitHub — token avec scope repo + workflow
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
TARGET_REPOSITORY=owner/repo

# LLM local (Ollama)
LLM_MODEL=qwen2.5

# Transport MCP (stdio|http)
MCP_TRANSPORT=stdio
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=3000